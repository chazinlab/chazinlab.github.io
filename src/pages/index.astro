---
import BaseLayout from '../layouts/BaseLayout.astro';
import Figure from '../components/Figure.astro';
import Citation from '../components/Citation.astro';
import { site } from '../site.config';
import { homePage } from '../lib/pages';
import { featuredPublications } from '../lib/publications';
import { researchThemes } from '../lib/research';

const home = await homePage();
const [themes, featured] = await Promise.all([researchThemes(), featuredPublications(home.data.featuredPapers)]);
---

<BaseLayout>
  <section class="section hero">
    <div class="container">
      <p class="eyebrow">{site.affiliation}</p>
      <h1>{site.name}</h1>
      <div class="lede mission"><home.Content /></div>
      <Figure image={home.data.figure} caption={home.data.caption} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Research</h2>
      <div class="themes">
        {
          themes.map((theme) => (
            <a class="theme-card" href={`/research#${theme.id}`}>
              <h3>{theme.name}</h3>
              <theme.Summary />
              <span class="more">Explore →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{featured.heading}</h2>
      <ul class="pub-list">
        {
          featured.publications.map((pub) => (
            <li>
              <Citation pub={pub} />
            </li>
          ))
        }
      </ul>
      <p><a href="/publications">All publications →</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero h1 {
    font-size: clamp(2.5rem, 7vw, 4rem);
    margin-bottom: var(--space-2);
  }

  .mission {
    margin-bottom: var(--space-4);
  }

  .mission :global(p) {
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    line-height: 1.55;
  }

  /* Flows to any number of themes: two or three side by side on wide screens, stacked on phones. */
  .themes {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .theme-card {
    display: block;
    padding: var(--space-4) var(--space-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .theme-card:hover {
    border-color: var(--link);
    color: var(--text);
  }

  .more {
    color: var(--link);
    font-weight: 500;
  }

  .pub-list {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
</style>
