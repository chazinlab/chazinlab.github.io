---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contactPage } from '../lib/pages';

const { data: { name, email, phone, address, directionsUrl }, Content } = await contactPage();
---

<BaseLayout title="Contact">
  <section class="section">
    <div class="container">
      <h1>Contact</h1>
    </div>
    <div class="container columns">
      <div>
        {name && <h2>{name}</h2>}
        <address>
          {address.map((line) => <span>{line}</span>)}
        </address>
        <p class="reach">
          {phone && <a href={`tel:${phone.replace(/[^\d+]/g, '')}`}>{phone}</a>}
          <a href={`mailto:${email}`}>{email}</a>
        </p>
        {directionsUrl && <p><a href={directionsUrl}>Directions →</a></p>}
      </div>
      <div>
        <h2>Joining the lab</h2>
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .columns {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .columns {
      grid-template-columns: 1fr 1.4fr;
    }
  }

  .reach {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-2);
  }
</style>
