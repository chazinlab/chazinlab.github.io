---
/** A current lab member: headshot (or initials), name, role, bio, email. */
import { Image } from 'astro:assets';
import type { Member } from '../lib/people';

interface Props {
  member: Member;
}

const { name, initials, role, photo, email, Bio } = Astro.props.member;
---

<article class="person">
  {photo ? (
    <Image class="photo" src={photo} alt={name} width={400} height={500} fit="cover" position="top" />
  ) : (
    <div class="photo initials" aria-hidden="true">
      {initials}
    </div>
  )}
  <h3>{name}</h3>
  <p class="role">{role}</p>
  <div class="bio">
    <Bio />
  </div>
  {email && <a href={`mailto:${email}`}>{email}</a>}
</article>

<style>
  .person {
    font-size: 0.95rem;
  }

  /* A portrait frame with lightly rounded corners, so the whole face and shoulders show.
     A photo taller than the frame loses its bottom edge; a wider one loses a little from each side. */
  .photo {
    width: 10rem;
    height: auto;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    object-fit: cover;
    object-position: top;
    margin-bottom: var(--space-2);
  }

  .initials {
    display: grid;
    place-items: center;
    background: var(--placeholder-bg);
    color: var(--muted);
    font-size: 1.75rem;
    font-weight: 600;
  }

  h3 {
    margin-bottom: 0.15rem;
  }

  .role {
    color: var(--muted);
    margin-bottom: var(--space-1);
  }
</style>
