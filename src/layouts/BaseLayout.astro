---
import { Font, Image } from 'astro:assets';
import { site } from '../site.config';
import { contactDetails } from '../lib/pages';
import '../styles/global.css';
import labLogo from '../assets/chazin-lab-logo-white.png';
import vanderbiltV from '../assets/vanderbilt-v.png';

interface Props {
  /** Page name for the browser tab; omit on the home page. */
  title?: string;
  description?: string;
}

const { title, description = `${site.name}, ${site.affiliation}` } = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/research', label: 'Research' },
  { href: '/people', label: 'People' },
  { href: '/publications', label: 'Publications' },
  { href: '/contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const contact = await contactDetails();

// Absolute addresses, for search engines and for the preview card shown when a link is shared.
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} logo`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-sans" preload />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href="/">
          <Image
            class="wordmark-lab"
            src={labLogo}
            alt={site.name}
            height={100}
            loading="eager"
            densities={[1, 2, 3]}
          />
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map(({ href, label }) => (
                <li>
                  <a href={href} aria-current={href === currentPath ? 'page' : undefined}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-id">
          <Image
            class="footer-logo"
            src={vanderbiltV}
            alt="Vanderbilt University"
            height={40}
            densities={[1, 2, 3]}
          />
          <div>
            <p class="footer-name">{site.name}</p>
            <address>
              {contact.address.map((line) => <span>{line}</span>)}
            </address>
          </div>
        </div>
        <p>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Black bar with white text: the header re-points the site's colour tokens for itself. */
  .site-header {
    --text: #ffffff;
    --heading: #ffffff;
    --link: #cfae70;
    background: #000000;
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-2);
  }

  .wordmark {
    display: inline-flex;
  }

  /* Tall enough for the NMR peaks above the lettering to read as contour rings. */
  .wordmark-lab {
    height: 6.25rem;
    width: auto;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    color: var(--heading);
    border-bottom-color: rgb(255 255 255 / 0.5);
  }

  nav a[aria-current='page'] {
    color: var(--heading);
    border-bottom-color: var(--link);
  }

  /* Phones: a smaller logo, and the five links spread across one line instead of wrapping. */
  @media (max-width: 30rem) {
    .wordmark-lab {
      height: 4.5rem;
    }

    nav {
      width: 100%;
    }

    nav ul {
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 0;
    }

    nav a {
      display: block;
      font-size: 0.8125rem;
      padding-block: var(--space-1) 0.25rem;
    }
  }

  /* Very narrow phones: a touch smaller so the labels do not touch. */
  @media (max-width: 21rem) {
    nav a {
      font-size: 0.75rem;
    }
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: var(--space-5);
    padding-block: var(--space-4);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .footer-id {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .footer-logo {
    height: 2.5rem;
    width: auto;
  }

  .footer-name {
    color: var(--heading);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  address {
    font-style: normal;
    display: flex;
    flex-direction: column;
  }
</style>
